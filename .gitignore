# Python 컴파일 결과 (기기마다 달라 충돌의 원인 — 절대 커밋하지 않는다)
__pycache__/
*.pyc

# OS가 만드는 잡파일
.DS_Store
Thumbs.db

# ── 빌드 단계 도입 (2026-08-16) ──
# 위 문단에 "나중에 빌드 단계가 생기면 출력을 dist/로 보내고 publish_dir을 dist로 지정하는 게
# 정석"이라고 적어뒀었다. 그 시점이 왔고, 배포처가 Vercel로 바뀌면서 publish_dir 얘기는
# 사라졌다 — Vercel이 저장소를 받아 스스로 빌드하고 dist/를 서빙한다.
# ⚠️ 그러므로 dist/와 node_modules/는 **커밋하지 않는다.** (옛 규칙: 사이트에 필요한 파일을
#    무시하면 gh-pages에서 404. 이제 사이트에 필요한 건 소스뿐이고 산출물은 빌드가 만든다)
node_modules/
dist/
*.tsbuildinfo

# ── 백엔드 도입 (2026-08-20) ──
# ⛔ DB 연결 문자열이 들어 있다. 커밋하면 그 순간 남이 내 DB에 붙을 수 있다.
#    (커밋해버렸다면 지우는 걸로 안 끝난다 — Neon에서 비밀번호를 새로 발급해야 한다)
# ⛔ 실제 값이 든 것은 전부 무시. (`.env*`는 Vercel CLI가 링크할 때 스스로 추가한 줄이다)
.env*
.vercel

# ⚠️ 단 **견본은 커밋한다.** 값이 하나도 없고, "이 앱에 무슨 환경변수가 필요한가"의
#    답이 적힌 유일한 곳이라 무시되면 새 기기에서 무엇을 채워야 하는지 알 길이 없다.
!.env.example
