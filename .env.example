# .env.example — 이 파일은 **모양만** 보여주는 견본이다. 값은 비어 있고 커밋된다.
# 실제 값은 `.env`에 넣는다 (.gitignore에 있어 커밋되지 않는다).
#
# 로컬: 이 파일을 복사해 `.env`로 만들고 값을 채운다.  cp .env.example .env
# 배포: Vercel 대시보드 → 프로젝트 → Settings → Environment Variables 에 같은 이름으로 넣는다.
#       ⚠️ 환경변수를 추가·수정하면 **다시 배포해야** 적용된다.
#
# ⛔ **`vercel env pull`로 로컬을 채울 수 없다** (2026-08-25에 확인). 이 파일의 값은 전부
#    Vercel에서 **Sensitive**로 넣어뒀는데, Sensitive는 "생성 후 값을 되읽을 수 없게" 저장하는
#    옵션이라 **Production·Preview에서만** 만들 수 있다. Development 환경이 막히는 건 버그가
#    아니라 정의상 모순이다 — Development 변수의 용도가 「내 컴퓨터로 끌어오는 것」인데,
#    끌어오려면 읽을 수 있어야 하기 때문이다.
#    ⭐ 그래도 Sensitive를 끄지 않는다: 값이 32자 이상이면 **빌드 로그에서 자동 [REDACTED]** 되고,
#       Vercel 계정·토큰이 털려도 값을 못 되읽는다. 대가는 로컬을 손으로 채우는 것뿐이다.

# Neon 대시보드 → Connection string (Pooled connection). postgresql://... 로 시작한다.
DATABASE_URL=

# 디스코드 채널 → 편집(⚙️) → 연동 → 웹훅 → 새 웹훅 → URL 복사.
# 비워두면 알림만 건너뛴다 (저장은 그대로 된다). 로컬에서는 보통 비워둔다.
DISCORD_WEBHOOK_URL=

# 레이트 리밋용 IP 해시에 섞는 소금. 아무 긴 문자열이나.
# ⚠️ 없으면 IP 후보가 좁아(IPv4는 43억) 해시를 되돌릴 수 있다 → 사실상 필수.
#    만드는 법:  node -e "console.log(crypto.randomUUID())"
FEEDBACK_IP_SALT=

# ────────────────────────── 인증 (2026-08-25, 개선안 5번) ──────────────────────────
# Google Cloud Console → 사용자 인증 정보 → 해당 OAuth 2.0 클라이언트 → 클라이언트 보안 비밀번호.
# ⛔ **이건 진짜 비밀이다.** 클라이언트 ID와 다르다 — ID는 공개 저장소에 있어도 되지만
#    (승인된 원본으로 도메인이 제한되니까) 시크릿은 서버 밖으로 나가면 안 된다.
# ⭐ 이 값을 둘 곳이 생긴 것이 2026-08-20(백엔드)이다. 그전엔 정적 사이트라 못 썼고,
#    그래서 코드 주석에 "시크릿은 아예 안 쓴다"고 적혀 있었다 — 자랑이 아니라 제약이었다.
GOOGLE_CLIENT_SECRET=
